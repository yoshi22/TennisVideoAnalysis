# CourtLens — build/runtime configuration
#
# Copy to `.env.local` (git-ignored) for local development.
# For EAS builds these are supplied as EAS environment variables; see eas.json.

# --- Supabase (video upload for cloud shot analysis) -------------------------
# Without these, the cloud analysis button is hidden in app/session/[id]/auto-score.tsx.
# Private bucket `beta-submissions` with anon INSERT/UPDATE/SELECT on analysis/%.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Sentry (crash reporting) ------------------------------------------------
# SENTRY_DSN empty  -> Sentry stays disabled at runtime.
# SENTRY_ORG/PROJECT empty -> the Sentry Expo plugin is not registered at all,
#   so builds never reach the source-map upload step.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Build-time only, used by sentry-cli to upload source maps.
# Store as an EAS *secret* — never commit a real value.
SENTRY_AUTH_TOKEN=
